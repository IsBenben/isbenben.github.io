[{"data":1,"prerenderedAt":305},["ShallowReactive",2],{"article-\u002Fpages\u002Floop-jam":3},{"current":4,"prev":299,"next":302},{"id":5,"title":6,"body":7,"date":257,"description":258,"downloads":261,"extension":262,"hide":263,"links":264,"meta":282,"navigation":283,"path":284,"seo":285,"stem":287,"tags":288,"__hash__":298},"pages\u002Fpages\u002Floop-jam.md","2^1024 Loops",{"type":8,"value":9,"toc":244},"minimark",[10,20,38,66,69,76,83,90,105,108,111,122,125,164,167,178,184,190,196,208,211],[11,12,6,15],"h1",{"id":13,"class":14},"_21024-loops","section-heading",[16,17],"a",{"class":18,"href":19},"section-link","#21024-loops",[21,22,23,24],"h2",{"id":23,"class":14},"游戏介绍",[16,25,27,33],{"class":18,"href":26},"#游戏介绍",[28,29,32],"span",{"className":30},[31],"visually-hidden","章节",[28,34,37],{"ariaHidden":35,"tabIndex":36},"true",-1," §",[39,40,41,44,45,51,52,57,58,61,62,65],"p",{},[42,43,6],"code",{}," 是由",[16,46,50],{"href":47,"rel":48},"https:\u002F\u002Fgithub.com\u002FMrRedShark77",[49],"nofollow","MrRedShark77","在",[16,53,56],{"href":54,"rel":55},"https:\u002F\u002Fgamemakerstoolkit.com\u002F",[49],"GMTK Game Jam 2025","上制作的游戏。游戏的目标是通过编程，达到 ",[42,59,60],{},"2^1024","（约 ",[42,63,64],{},"1.8x10^308","）。",[39,67,68],{},"通过鼠标操作，移动各种代码，拼接复杂的程序。说明见下图：",[39,70,71],{},[72,73],"img",{"alt":74,"src":75},"2^1024 Loops编程增量游戏代码操作说明示意图","https:\u002F\u002Fisbenben.github.io\u002Floop-jam-cn\u002Ftextures\u002Fhelp.png",[39,77,78,79,82],{},"单击\"运行（Run）\"按钮可以运行代码，一次运行成为一个\"",[42,80,81],{},"loop","\"。会实时展现当前运行状态，再按一次可以加速（Fast）运行一整轮代码。",[39,84,85,86,89],{},"游戏有一个个目标（goal）：让",[42,87,88],{},"P","变量达到一个值。达到的值随游戏进程而增大。",[39,91,92,93,96,97,100,101,104],{},"在完成目标后，可以从",[42,94,95],{},"6","项奖励（Reward）中选择最多",[42,98,99],{},"3","项奖励。奖励有",[42,102,103],{},"5","个等级，获得概率递减。若找不到自己想要的奖励，可以使用 3 次\"重掷（Reroll）\"机会，生成新的 6 项奖励。选择奖励代码后，可以在后续的 loop 中使用。",[39,106,107],{},"在达到 2^1024 后，还可以选择开启无尽模式（Endless Mode）。无尽模式顾名思义，没有真正的结束，但是你可以无限挑战自己的 P，冲向属于你的极限。",[39,109,110],{},"游戏还有一些成就（Achievement）等着你去挑战！",[21,112,113,114],{"id":113,"class":14},"插件介绍",[16,115,117,120],{"class":18,"href":116},"#插件介绍",[28,118,32],{"className":119},[31],[28,121,37],{"ariaHidden":35,"tabIndex":36},[39,123,124],{},"插件由我制作，提供五个可自由开关的功能：",[126,127,128,140,146,152,158],"ul",{},[129,130,131,135,136,139],"li",{},[132,133,134],"strong",{},"使用弃用的奖励算法：","打开原作者注释掉的奖励算法。代码片段：",[42,137,138],{},"j === 2 ? 1 \u002F Math.max(200, 1000 \u002F player.nextP.add(9).log10().cbrt()) :","。",[129,141,142,145],{},[132,143,144],{},"现代化样式：","启用现代化样式，包括弹框动画，图标修复，滚动条样式，圆角槽位等杂项修改。",[129,147,148,151],{},[132,149,150],{},"无限重掷：","有无限次\"重掷（Reroll）\"机会。",[129,153,154,157],{},[132,155,156],{},"获得无限块：","用于测试，启用后无限获得奖励块。",[129,159,160,163],{},[132,161,162],{},"排序物品栏：","自动排序物品栏。数字，运算符，变量等均可自动排序。",[39,165,166],{},"插件的设置会保存在玩家数据中，默认启用现代化样式和排序物品栏。",[21,168,169,170],{"id":169,"class":14},"截图",[16,171,173,176],{"class":18,"href":172},"#截图",[28,174,32],{"className":175},[31],[28,177,37],{"ariaHidden":35,"tabIndex":36},[39,179,180],{},[72,181],{"alt":182,"src":183},"2^1024 Loops编程增量游戏主菜单截图","\u002Fraw\u002Floop-jam-main-menu.png",[39,185,186],{},[72,187],{"alt":188,"src":189},"2^1024 Loops编程增量游戏选择奖励界面截图","\u002Fraw\u002Floop-jam-choosing-rewards.png",[39,191,192],{},[72,193],{"alt":194,"src":195},"2^1024 Loops编程增量游戏成就界面截图","\u002Fraw\u002Floop-jam-achivements.png",[21,197,199,200],{"id":198,"class":14},"license","License",[16,201,203,206],{"class":18,"href":202},"#license",[28,204,32],{"className":205},[31],[28,207,37],{"ariaHidden":35,"tabIndex":36},[39,209,210],{},"源代码改编以 MIT License 许可。",[39,212,213,214,218,219,223,224,228,229,233,234,238,239,243],{},"外部库引用：Lodash.js (",[16,215,199],{"href":216,"rel":217},"https:\u002F\u002Fgithub.com\u002Flodash\u002Flodash\u002Fblob\u002Fmain\u002FLICENSE",[49],") | Vue.js (",[16,220,199],{"href":221,"rel":222},"https:\u002F\u002Fgithub.com\u002Fvuejs\u002Fvue\u002Fblob\u002Fmain\u002FLICENSE",[49],") | Noto Sans SC (",[16,225,199],{"href":226,"rel":227},"https:\u002F\u002Fgithub.com\u002Fnotofont