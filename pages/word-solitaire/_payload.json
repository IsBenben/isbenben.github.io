[{"data":1,"prerenderedAt":194},["ShallowReactive",2],{"article-\u002Fpages\u002Fword-solitaire":3},{"current":4,"prev":188,"next":191},{"id":5,"title":6,"body":7,"date":155,"description":156,"downloads":159,"extension":163,"hide":164,"links":165,"meta":171,"navigation":172,"path":173,"seo":174,"stem":176,"tags":177,"__hash__":187},"pages\u002Fpages\u002Fword-solitaire.md","单词接龙",{"type":8,"value":9,"toc":143},"minimark",[10,19,23,41,70,73,84,95,98,101,108,119,122,125,136],[11,12,6,14],"h1",{"id":6,"class":13},"section-heading",[15,16],"a",{"class":17,"href":18},"section-link","#单词接龙",[20,21,22],"p",{},"单词接龙是一个经典的文字游戏，玩家需要根据前一个单词的尾字母，找到一个以该字母开头的新单词。这个网页版游戏支持 AI 辅助和单词释义查询。",[24,25,26,27],"h2",{"id":26,"class":13},"基本规则",[15,28,30,36],{"class":17,"href":29},"#基本规则",[31,32,35],"span",{"className":33},[34],"visually-hidden","章节",[31,37,40],{"ariaHidden":38,"tabIndex":39},"true",-1," §",[42,43,44,52,58,64],"ul",{},[45,46,47,51],"li",{},[48,49,50],"strong",{},"首尾相接","：新单词的首字母需要和前一个单词的尾字母完全相同。",[45,53,54,57],{},[48,55,56],{},"单词有效","：单词必须在游戏字典中，否则无效。",[45,59,60,63],{},[48,61,62],{},"无重复","：同一个单词在一轮游戏中不能重复使用。",[45,65,66,69],{},[48,67,68],{},"大小写敏感","：只有小写字母被接受。",[20,71,72],{},"示例如下：",[74,75,80],"pre",{"className":76,"code":78,"language":79},[77],"language-text","apple->elephant->tiger->rabbit\n  ->monkey（首尾不相接，无效）\n  ->tiger (重复，无效)\n  ->ttt（不在字典中，无效）\n  ->TURKEY（大小写错误，无效）\n  ->turkey（正确接龙）\n","text",[81,82,78],"code",{"__ignoreMap":83},"",[24,85,86,87],{"id":86,"class":13},"操作方法",[15,88,90,93],{"class":17,"href":89},"#操作方法",[31,91,35],{"className":92},[34],[31,94,40],{"ariaHidden":38,"tabIndex":39},[20,96,97],{},"输入框中输入单词即开始。若没有单词可接龙，会自动显示消息。",[20,99,100],{},"在游戏过程中，将鼠标放在单词上，可查看单词的意思。",[20,102,103,104,107],{},"如果不会，可以点击“询问AI”进行 ",[81,105,106],{},"AI"," 辅助，基于输入匹配单词。",[24,109,110,111],{"id":110,"class":13},"游戏特色",[15,112,114,117],{"class":17,"href":113},"#游戏特色",[31,115,35],{"className":116},[34],[31,118,40],{"ariaHidden":38,"tabIndex":39},[20,120,121],{},"词汇库支持约15000词接龙和释义查询，涵盖基础词汇、学术词汇等，自动验证输入的单词是否有效。",[20,123,124],{},"释义涵盖基本释义、词性、常见短语对照，可配合玩家理解、学习单词。",[24,126,127,128],{"id":127,"class":13},"截图",[15,129,131,134],{"class":17,"href":130},"#截图",[31,132,35],{"className":133},[34],[31,135,40],{"ariaHidden":38,"tabIndex":39},[20,137,138],{},[139,140],"img",{"alt":141,"src":142},"单词接龙学习游戏界面","\u002Fraw\u002Fword-solitaire-screenshot.png",{"title":83,"searchDepth":144,"depth":145,"links":146},2,3,[147,149,151,153],{"id":26,"depth":144,"text":148},"基本规则章节 §",{"id":86,"depth":144,"text":150},"操作方法章节 §",{"id":110,"depth":144,"text":152},"游戏特色章节 §",{"id":127,"depth":144,"text":154},"截图章节 §","2025\u002F03\u002F07",[157,158],"单词接龙是一个经典的文字游戏，只要新单词的首字母和前一个单词的尾字母相同，就可以接上。","这个网页版游戏支持不会时AI辅助和释义查询。",[160],[161,162],"\u002Fraw\u002Fword-solitaire.html","下载","md",false,[166,169],[167,168],"https:\u002F\u002Fgithub.com\u002FIsBenben\u002FFunny-Things\u002Fblob\u002Fmain\u002Fword-solitaire.html","源代码",[161,170],"体验",{},true,"\u002Fpages\u002Fword-solitaire",{"title":6,"description":175},[157,158],"pages\u002Fword-solitaire",[178,181,184],[179,180],"lang","web",[182,183],"inspiration","original",[185,186],"content","entertainment","WhyKIGqBc04pXuzIbYkSifl8lC7QtZ9eNBVB4YDljnk",{"title":189,"path":190},"文件消消乐","\u002Fpages\u002Ffile-matchmaking",{"title":192,"path":193},"动画计算器","\u002Fpages\u002Fanimated-calculator",1789650708784]