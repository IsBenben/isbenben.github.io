[{"data":1,"prerenderedAt":248},["ShallowReactive",2],{"article-\u002Fpages\u002Flife-game":3},{"current":4,"prev":242,"next":245},{"id":5,"title":6,"body":7,"date":204,"description":205,"downloads":209,"extension":216,"hide":217,"links":218,"meta":225,"navigation":226,"path":227,"seo":228,"stem":230,"tags":231,"__hash__":241},"pages\u002Fpages\u002Flife-game.md","Scratch生命游戏",{"type":8,"value":9,"toc":191},"minimark",[10,20,38,42,50,62,65,124,136,146,149,160,167,178,185],[11,12,6,15],"h1",{"id":13,"class":14},"scratch生命游戏","section-heading",[16,17],"a",{"class":18,"href":19},"section-link","#scratch生命游戏",[21,22,23,24],"h2",{"id":23,"class":14},"生命游戏介绍",[16,25,27,33],{"class":18,"href":26},"#生命游戏介绍",[28,29,32],"span",{"className":30},[31],"visually-hidden","章节",[28,34,37],{"ariaHidden":35,"tabIndex":36},"true",-1," §",[39,40,41],"p",{},"生命游戏由英国数学家康威于1970年发明。它在一个二维方格世界中模拟细胞的生死状态，细胞的存活与否取决于周围相邻细胞的数量。具体规则包括：如果一个细胞周围活细胞过少，它会死亡；如果活细胞过多，它也会死亡；只有在适当的邻居数量下，细胞才能存活。",[39,43,44,45,49],{},"本程序模拟了生命游戏的一种规则：",[46,47,48],"code",{},"B3\u002FS23","。意思是，若细胞周围有3个细胞，则会繁殖新细胞；而若细胞周围有2或3个细胞，则会保持当前状态。需使用TurboWarp运行，或点击快捷体验。",[21,51,53,54],{"id":52,"class":14},"操作方法新版本","操作方法（新版本）",[16,55,57,60],{"class":18,"href":56},"#操作方法新版本",[28,58,32],{"className":59},[31],[28,61,37],{"ariaHidden":35,"tabIndex":36},[39,63,64],{},"新版本是自制的无限地图生命游戏。关键算法包括哈希等。",[66,67,68,76,82,88,94,100,106,112,118],"ul",{},[69,70,71,75],"li",{},[72,73,74],"strong",{},"工具栏：","包含多个功能，鼠标单击舞台最下方开启，再次单击上方关闭。",[69,77,78,81],{},[72,79,80],{},"添加细胞：","鼠标操作，移动到合适位置，拖拽添加多个细胞。",[69,83,84,87],{},[72,85,86],{},"删除细胞：","在工具栏中点击\"画笔\"第一项，后与添加细胞相同。",[69,89,90,93],{},[72,91,92],{},"清空细胞：","在工具栏中点击\"清空\"，注意清空操作不可撤回。",[69,95,96,99],{},[72,97,98],{},"粗细调整：","在工具栏中点击\"画笔\"第二项，有1x1到3x3三种粗细选择。",[69,101,102,105],{},[72,103,104],{},"位移：","键盘WASD，分别对应上左下右移动。",[69,107,108,111],{},[72,109,110],{},"缩放：","鼠标滚轮，滚动可动态调整缩放。",[69,113,114,117],{},[72,115,116],{},"重置移缩：","在工具栏中点击\"回家\"即可。",[69,119,120,123],{},[72,121,122],{},"模拟：","在工具栏中点击\"播放\"切换模拟运行状态，模拟规则见上。",[21,125,127,128],{"id":126,"class":14},"附加说明旧版本","附加说明（旧版本）",[16,129,131,134],{"class":18,"href":130},"#附加说明旧版本",[28,132,32],{"className":133},[31],[28,135,37],{"ariaHidden":35,"tabIndex":36},[39,137,138,139,145],{},"旧版本生命游戏主要参考",[16,140,144],{"href":141,"rel":142},"https:\u002F\u002Fwww.bilibili.com\u002Fvideo\u002FBV1aB4y1W7cK",[143],"nofollow","编程侯老师","的教程视频制作。",[39,147,148],{},"仅需使用鼠标操作：",[66,150,151,154,157],{},[69,152,153],{},"左侧为地图相关设置，如随机地图，清空地图，和4种预设的地图。",[69,155,156],{},"右上侧为模拟状态。单击下一代模拟一次，长按快速模拟。下面可显示自上次清空，模拟的总代数。",[69,158,159],{},"右下侧为控制细胞，可实现基本的添加、删除细胞。",[39,161,162,163,166],{},"旧版本制作于 ",[46,164,165],{},"2022\u002F12\u002F22","。该版本提供有限的地图，且存在一定bug。暂不提供在线体验链接。",[21,168,169,170],{"id":169,"class":14},"截图",[16,171,173,176],{"class":18,"href":172},"#截图",[28,174,32],{"className":175},[31],[28,177,37],{"ariaHidden":35,"tabIndex":36},[39,179,180],{},[181,182],"img",{"alt":183,"src":184},"在Scratch无限生命游戏模拟高斯帕滑翔枪","\u002Fraw\u002Finfinity-life-game-screenshot.png",[39,186,187],{},[181,188],{"alt":189,"src":190},"在Scratch生命游戏中模拟简单飞船","\u002Fraw\u002Flife-game-screenshot.png",{"title":192,"searchDepth":193,"depth":194,"links":195},"",2,3,[196,198,200,202],{"id":23,"depth":193,"text":197},"生命游戏介绍章节 §",{"id":52,"depth":193,"text":199},"操作方法（新版本）章节 §",{"id":126,"depth":193,"text":201},"附加说明（旧版本）章节 §",{"id":169,"depth":193,"text":203},"截图章节 §","2025\u002F07\u002F20",[206,207,208],"本程序模拟了生命游戏的一种规则：B3\u002FS23，即康威生命游戏的初始版本。","新版本是自制的无限地图生命游戏，操作简单。","旧版本参考教程视频，提供有限的地图。",[210,213],[211,212],"\u002Fraw\u002Finfinity-life-game.sb3","下载：新版本",[214,215],"\u002Fraw\u002Flife-game.sb3","下载：旧版本","md",false,[219,222],[220,221],"https:\u002F\u002Fwww.bilibili.com\u002Fvideo\u002FBV1ingezAEem\u002F","演示视频（新版本）",[223,224],"\u002Fraw\u002Finfinity-life-game.html","体验：新版本",{},true,"\u002Fpages\u002Flife-game",{"title":6,"description":229},[206,207,208],"pages\u002Flife-game",[232,235,238],[233,234],"lang","scratch3",[236,237],"inspiration","adaptation",[239,240],"content","art","T1fcYeSq4jCC4fwzefXxF3VDHsNP6qYtZOdOdmOCAh0",{"title":243,"path":244},"动画计算器","\u002Fpages\u002Fanimated-calculator",{"title":246,"path":247},"2^1024 Loops","\u002Fpages\u002Floop-jam",1789650708766]