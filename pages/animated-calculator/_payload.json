[{"data":1,"prerenderedAt":334},["ShallowReactive",2],{"article-\u002Fpages\u002Fanimated-calculator":3},{"current":4,"prev":328,"next":331},{"id":5,"title":6,"body":7,"date":297,"description":298,"downloads":301,"extension":305,"hide":306,"links":307,"meta":311,"navigation":312,"path":313,"seo":314,"stem":316,"tags":317,"__hash__":327},"pages\u002Fpages\u002Fanimated-calculator.md","动画计算器",{"type":8,"value":9,"toc":282},"minimark",[10,19,37,104,115,185,196,204,231,242,264,275],[11,12,6,14],"h1",{"id":6,"class":13},"section-heading",[15,16],"a",{"class":17,"href":18},"section-link","#动画计算器",[20,21,22,23],"h2",{"id":22,"class":13},"运算能力",[15,24,26,32],{"class":17,"href":25},"#运算能力",[27,28,31],"span",{"className":29},[30],"visually-hidden","章节",[27,33,36],{"ariaHidden":34,"tabIndex":35},"true",-1," §",[38,39,40,53,71,81,91],"ul",{},[41,42,43,47,48,52],"li",{},[44,45,46],"strong",{},"基础运算","：支持 ",[49,50,51],"code",{},"+-*\u002F"," 四则运算，遵循标准优先级（先乘除后加减）。",[41,54,55,58,59,62,63,66,67,70],{},[44,56,57],{},"幂运算","：使用 ",[49,60,61],{},"^"," 符号表示乘方，优先级高于乘除，右结合（如 ",[49,64,65],{},"2^3^2"," = ",[49,68,69],{},"2^(3^2)","）。",[41,72,73,76,77,80],{},[44,74,75],{},"括号支持","：允许任意嵌套的 ",[49,78,79],{},"()"," 括号，改变运算顺序。",[41,82,83,86,87,90],{},[44,84,85],{},"负数处理","：支持负号直接输入（如 ",[49,88,89],{},"5+-3"," 解析为 5 + (-3)），也支持负数作为表达式起始。",[41,92,93,96,97,100,101,70],{},[44,94,95],{},"小数缩写","：小数点前后可省略 0（如输入 ",[49,98,99],{},".5"," 自动补全为 ",[49,102,103],{},"0.5",[20,105,106,107],{"id":106,"class":13},"交互体验",[15,108,110,113],{"class":17,"href":109},"#交互体验",[27,111,31],{"className":112},[30],[27,114,36],{"ariaHidden":34,"tabIndex":35},[38,116,117,158,179],{},[41,118,119,122,123],{},[44,120,121],{},"按键输入","：\n",[38,124,125,155],{},[41,126,127,128,131,132,135,136,139,140,142,143,146,147,150,151,154],{},"提供数字键 ",[49,129,130],{},"0-9","、小数点 ",[49,133,134],{},".","、运算符 ",[49,137,138],{},"+-*\u002F^","、括号 ",[49,141,79],{},"、退格 ",[49,144,145],{},"\u003C","、清空 ",[49,148,149],{},"AC","、等于 ",[49,152,153],{},"=","。",[41,156,157],{},"支持按键连输，退格键长按可连续快速删除；数字和运算符长按可重复输入。",[41,159,160,122,163],{},[44,161,162],{},"光标移动",[38,164,165,176],{},[41,166,167,168,171,172,175],{},"支持 ",[49,169,170],{},"←"," ",[49,173,174],{},"→"," 移动光标，可在表达式任意位置插入\u002F删除。",[41,177,178],{},"光标移动带有非线性缓动动画，视觉反馈柔和。",[41,180,181,184],{},[44,182,183],{},"流畅动效","：所有按键按下时有缩放反馈；光标移动具有缓动效果。",[20,186,187,188],{"id":187,"class":13},"核心算法实现",[15,189,191,194],{"class":17,"href":190},"#核心算法实现",[27,192,31],{"className":193},[30],[27,195,36],{"ariaHidden":34,"tabIndex":35},[197,198,199,200,203],"p",{},"解析策略采用",[44,201,202],{},"递归下降 + 结果栈","解析表达式字符串。",[205,206,207,213,219,225],"ol",{},[41,208,209,212],{},[44,210,211],{},"词法分析","：将输入字符串拆解为Token（数字、运算符、括号、负号标记）。",[41,214,215,218],{},[44,216,217],{},"数值计算","：树形遍历Token，执行运算。遇到除零、NaN、无穷大等异常时，停止递归并抛出错误。",[41,220,221,224],{},[44,222,223],{},"递归回溯","：若计算过程中某节点失败，则向上回溯，将整个表达式标记为无效，并清空栈顶中间结果。",[41,226,227,230],{},[44,228,229],{},"最终输出","：成功解析且无错误时，栈顶即为最终计算结果；否则反馈错误信息。",[20,232,233,234],{"id":233,"class":13},"错误处理与用户反馈",[15,235,237,240],{"class":17,"href":236},"#错误处理与用户反馈",[27,238,31],{"className":239},[30],[27,241,36],{"ariaHidden":34,"tabIndex":35},[38,243,244,250,256],{},[41,245,246,249],{},[44,247,248],{},"实时检查","：输入时动态显示错误消息。",[41,251,252,255],{},[44,253,254],{},"计算错误提示","：语法错误如括号不匹配、Token解析错误，数字格式错误分别显示不同消息。",[41,257,258,263],{},[44,259,260],{},[49,261,262],{},"NaN","：针对常见除0，Infinity加减除等运算错误自动识别。",[20,265,266,267],{"id":266,"class":13},"截图",[15,268,270,273],{"class":17,"href":269},"#截图",[27,271,31],{"className":272},[30],[27,274,36],{"ariaHidden":34,"tabIndex":35},[197,276,277],{},[278,279],"img",{"alt":280,"src":281},"使用Scratch动画计算器计算嵌套表达式","\u002Fraw\u002Fanimated-calculator-screenshot.png",{"title":283,"searchDepth":284,"depth":285,"links":286},"",2,3,[287,289,291,293,295],{"id":22,"depth":284,"text":288},"运算能力章节 §",{"id":106,"depth":284,"text":290},"交互体验章节 §",{"id":187,"depth":284,"text":292},"核心算法实现章节 §",{"id":233,"depth":284,"text":294},"错误处理与用户反馈章节 §",{"id":266,"depth":284