[{"data":1,"prerenderedAt":200},["ShallowReactive",2],{"article-\u002Fpages\u002Fnumbers-eating-game":3},{"current":4,"prev":194,"next":197},{"id":5,"title":6,"body":7,"date":162,"description":163,"downloads":167,"extension":171,"hide":172,"links":173,"meta":177,"navigation":178,"path":179,"seo":180,"stem":182,"tags":183,"__hash__":193},"pages\u002Fpages\u002Fnumbers-eating-game.md","大数吃小数游戏",{"type":8,"value":9,"toc":144},"minimark",[10,19,37,49,58,61,72,75,78,85,96,103,114,117,120,123,126,137],[11,12,6,14],"h1",{"id":6,"class":13},"section-heading",[15,16],"a",{"class":17,"href":18},"section-link","#大数吃小数游戏",[20,21,22,23],"h2",{"id":22,"class":13},"游戏设定",[15,24,26,32],{"class":17,"href":25},"#游戏设定",[27,28,31],"span",{"className":29},[30],"visually-hidden","章节",[27,33,36],{"ariaHidden":34,"tabIndex":35},"true",-1," §",[38,39,40,41],"h3",{"id":40,"class":13},"基础规则",[15,42,44,47],{"class":17,"href":43},"#基础规则",[27,45,31],{"className":46},[30],[27,48,36],{"ariaHidden":34,"tabIndex":35},[50,51,52,53,57],"p",{},"舞台一开始会刷新数字 ",[54,55,56],"code",{},"1","，即你操控的数字。你通过方向键操控着数字上下左右移动。",[50,59,60],{},"你的数字如果碰到比它小的数字，就会“吃掉”它，并加上它的数值。但是，如果你的数字碰到比它大的数字，你就输了。",[38,62,63,64],{"id":63,"class":13},"数字生成",[15,65,67,70],{"class":17,"href":66},"#数字生成",[27,68,31],{"className":69},[30],[27,71,36],{"ariaHidden":34,"tabIndex":35},[50,73,74],{},"舞台上会从四面八方随机位置，按一定频率刷新刷新数字。有的数字大，有的数字小了，根据玩家数字大小动态调整。",[50,76,77],{},"数字会在随机位置，一定频率刷新，大小，。",[50,79,80,81,84],{},"数字包含包含简单数字和四则算式，即包含加法、减法、乘法、除法的简单算式（",[54,82,83],{},"+-*\u002F","），需要计算才能吃数字。算式逐步解锁，会随着你的数字越来越大，变得越来越难。",[20,86,87,88],{"id":87,"class":13},"操作方法",[15,89,91,94],{"class":17,"href":90},"#操作方法",[27,92,31],{"className":93},[30],[27,95,36],{"ariaHidden":34,"tabIndex":35},[50,97,98,99,102],{},"鼠标点击“Restart”（重启）开始游戏。使用",[54,100,101],{},"↑↓←→","方向键移动数字。",[20,104,105,106],{"id":105,"class":13},"游戏技巧",[15,107,109,112],{"class":17,"href":108},"#游戏技巧",[27,110,31],{"className":111},[30],[27,113,36],{"ariaHidden":34,"tabIndex":35},[50,115,116],{},"在初期，玩家需要谨慎移动，避免冒险，快速积累初始数值。",[50,118,119],{},"中期，玩家需要主动出击，规划路线，尝试吃掉中等数字。",[50,121,122],{},"对于后期计算，玩家需要提升运算速度，并进行一定估算，才能吃掉正确的数字。",[50,124,125],{},"这个游戏是无尽模式的，挑战你的极限吧！",[20,127,128,129],{"id":128,"class":13},"截图",[15,130,132,135],{"class":17,"href":131},"#截图",[27,133,31],{"className":134},[30],[27,136,36],{"ariaHidden":34,"tabIndex":35},[50,138,139],{},[140,141],"img",{"alt":142,"src":143},"大数吃小数数学游戏画面截图","\u002Fraw\u002Fnumbers-eating-game-screenshot.png",{"title":145,"searchDepth":146,"depth":147,"links":148},"",2,3,[149,156,158,160],{"id":22,"depth":146,"text":150,"children":151},"游戏设定章节 §",[152,154],{"id":40,"depth":147,"text":153},"基础规则章节 §",{"id":63,"depth":147,"text":155},"数字生成章节 §",{"id":87,"depth":146,"text":157},"操作方法章节 §",{"id":105,"depth":146,"text":159},"游戏技巧章节 §",{"id":128,"depth":146,"text":161},"截图章节 §","2025\u002F02\u002F17",[164,165,166],"你通过↑↓←→方向键操控着数字1。舞台上随机刷新数字。","这个数字碰到比它小的数字就会吃掉它，并加上它的数值。","游戏后期还会解锁+-*\u002F和更大的数字！挑战极限！",[168],[169,170],"\u002Fraw\u002Fnumbers-eating-game.sb3","下载游戏SB3","md",false,[174],[175,176],"\u002Fraw\u002Fnumbers-eating-game.html","体验游戏",{},true,"\u002Fpages\u002Fnumbers-eating-game",{"title":6,"description":181},[164,165,166],"pages\u002Fnumbers-eating-game",[184,187,190],[185,186],"lang","scratch3",[188,189],"inspiration","adaptation",[191,192],"content","entertainment","i44ZtrCd8y81I-LVIUQWODpgF-l4yRHVbW70Q01M0Ts",{"title":195,"path":196},"小鸡跑酷","\u002Fpages\u002Fchicken-parkour",{"title":198,"path":199},"文件消消乐","\u002Fpages\u002Ffile-matchmaking",1788521248871]