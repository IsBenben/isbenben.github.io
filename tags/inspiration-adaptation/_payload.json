[{"data":1,"prerenderedAt":130},["ShallowReactive",2],{"tag-inspiration-adaptation":3},[4,22,34,47,60,71,84,96,107,118],{"title":5,"description":6,"date":10,"tags":11,"path":21},"数字论证生成器",[7,8,9],"一个基于 Web 的数字论证生成器，可用指定整数自动构造表达式来论证任意实数。","支持实时搜索、数学符号\u002FPython\u002FTeX 多格式输出、分享链接与高级搜索选项。","内置表达式树自动化简与实数分解规则，适合数学娱乐、表达式构造与 Web 工具探索。","2026-11-03",[12,15,18],[13,14],"lang","web",[16,17],"inspiration","adaptation",[19,20],"content","tool","\u002Fpages\u002Fnum-proof-gen",{"title":23,"description":24,"date":27,"tags":28,"path":33},"EPFLimitRemover",[25,26],"EPFLimitRemover是一个可配置的Minecraft模组，用于修改原版魔咒保护系数EPF的上限。","兼容Minecraft 1.21~1.21.11全系列版本。通过轻量级Mixin注入原版游戏。","2026-05-30",[29,31,32],[13,30],"minecraft",[16,17],[19,20],"\u002Fpages\u002Fepf-limit-remover",{"title":35,"description":36,"date":40,"tags":41,"path":46},"谷歌翻译十遍（语言包）",[37,38,39],"该资源包添加一种语言，名叫“中文（谷歌翻译十遍）”。","其文本使用谷歌翻译，从英文开始，在随机语言间翻译，最后出现一些滑稽的翻译结果。","支持Minecraft 1.21.9。","2026-02-13",[42,43,44],[13,30],[16,17],[19,45],"art","\u002Fpages\u002Fgoogle-10",{"title":48,"description":49,"date":53,"tags":54,"path":59},"Scratch生命游戏",[50,51,52],"本程序模拟了生命游戏的一种规则：B3\u002FS23，即康威生命游戏的初始版本。","新版本是自制的无限地图生命游戏，操作简单。","旧版本参考教程视频，提供有限的地图。","2025-07-20",[55,57,58],[13,56],"scratch3",[16,17],[19,45],"\u002Fpages\u002Flife-game",{"title":61,"description":62,"date":65,"tags":66,"path":70},"动画计算器",[63,64],"支持多种运算格式，负数，小数。用户操作有非线性的流畅动效。支持识别常见语法错误，计算错误。","纯Scratch实现，利用到栈，递归等技巧，实时显示运算结果。","2025-04-29",[67,68,69],[13,56],[16,17],[19,20],"\u002Fpages\u002Fanimated-calculator",{"title":72,"description":73,"date":77,"tags":78,"path":83},"大数吃小数游戏",[74,75,76],"你通过↑↓←→方向键操控着数字1。舞台上随机刷新数字。","这个数字碰到比它小的数字就会吃掉它，并加上它的数值。","游戏后期还会解锁+-*\u002F和更大的数字！挑战极限！","2025-02-17",[79,80,81],[13,56],[16,17],[19,82],"entertainment","\u002Fpages\u002Fnumbers-eating-game",{"title":85,"description":86,"date":90,"tags":91,"path":95},"Oh my dear JavaScript",[87,88,89],"在JavaScript中，==相等运算符有一些特殊的行为。","这个消消乐游戏利用了这一特点。","只要每个选择的相邻元素满足==判断为true，就可以消除。消除的越多得分越多。","2025-0