[{"data":1,"prerenderedAt":104},["ShallowReactive",2],{"tag-lang-web":3},[4,21,34,44,57,68,79,92],{"title":5,"description":6,"date":9,"tags":10,"path":20},"JavaScript布尔值异或（xor）",[7,8],"在JavaScript中定义xor异或函数，传入两个布尔值，返回参数异或结果。","本文介绍四种方法实现布尔值异或，可根据实际需求选择。","2026\u002F09\u002F03",[11,14,17],[12,13],"lang","web",[15,16],"inspiration","original",[18,19],"content","snippet","\u002Fpages\u002Fjs-boolean-xor",{"title":22,"description":23,"date":27,"tags":28,"path":33},"猜词游戏",[24,25,26],"这是一个基于Web的猜词游戏，支持键盘输入字母，实时显示统计信息。","游戏内置约5000个单词库，可将当前单词编码为分享链接，实现单词的便捷传播与挑战。","页面采用响应式布局，适配PC与移动端，提供流畅的猜词体验。","2026\u002F05\u002F20",[29,30,31],[12,13],[15,16],[18,32],"entertainment","\u002Fpages\u002Fguess-the-word",{"title":35,"description":36,"date":38,"tags":39,"path":43},"Nuxt Content自定义哈希与章节符号",[37],"本文介绍了在rehype中通过两个插件，实现的自定义哈希与章节符号，并提供其配置方法。","2026\u002F05\u002F16",[40,41,42],[12,13],[15,16],[18,19],"\u002Fpages\u002Fnuxt-custom-toc",{"title":45,"description":46,"date":50,"tags":51,"path":56},"Village of Chaos",[47,48,49],"简短文字放置游戏，原生JS编写，轻松挂机发展村庄。","支持多语言切换，覆盖中文简繁体。","完全免费在线游玩，无需下载即开即玩。","2026\u002F03\u002F06",[52,53,55],[12,13],[15,54],"localization",[18,32],"\u002Fpages\u002Fvillage-of-chaos",{"title":58,"description":59,"date":62,"tags":63,"path":67},"2^1024 Loops",[60,61],"2^1024 Loops 是由 MrRedShark77 在 GMTK Game Jam 2025 上制作的游戏。游戏的目标是通过编程，达到 2^1024（约 1.8x10^308）。","本文章提供游戏相关教程和攻略。","2025\u002F08\u002F14",[64,65,66],[12,13],[15,54],[18,32],"\u002Fpages\u002Floop-jam",{"title":69,"description":70,"date":73,"tags":74,"path":78},"单词接龙",[71,72],"单词接龙是一个经典的文字游戏，只要新单词的首字母和前一个单词的尾字母相同，就可以接上。","这个网页版游戏支持不会时AI辅助和释义查询。","2025\u002F03\u002F07",[75,76,77],[12,13],[15,16],[18,32],"\u002Fpages\u002Fword-solitaire",{"title":80,"description":81,"date":84,"tags":85,"path":91},"XXXX 论证器",[82,83],"这个小程序复制了以 MIT License 开源的 https:\u002F\u002Fgithub.com\u002Fitorr\u002Fhomo 代码。","可论证任何数字为 5277 和 7725。","2025\u002F02\u002F03",[86,87,89],[12,13],[15,88],"adaptation",[18,90],"tool","\u002Fpages\u002Fdemonstrator",{"title":93,"description":94,"date":98,"tags":99,"path":103},"快速添加到收藏夹",[95,96,97],"这是一个 Chrome 浏览器插件，需要开启开发者模式导入该插件，在 B 站视频中就可以快速添加到收藏夹。","快速添加到收藏夹：根据B站视频的标签自动创建并匹配收藏夹。","原理：通过 JS 脚本操作 DOM 元素，模拟点击按钮和输入，实现快速添加到收藏夹。","2024\u002F12\u002F05",[100,101,102],[12,13],[15,16],[18,90],"\u002Fpages\u002Ffast-collection",1789650708472]